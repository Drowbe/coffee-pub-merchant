<div class="merchant-shop-content">
    {{#if busyLabel}}
        {{!-- Zero-height sticky rail: the panel floats over the dimmed list and does
              not scroll away, without competing for top: 0 with the pinned header. --}}
        <div class="merchant-shop-working" role="status" aria-live="polite">
            <div class="merchant-shop-working-panel">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span>{{busyLabel}}&hellip;</span>
            </div>
        </div>
    {{/if}}
    {{#if missing}}
        <div class="merchant-shop-empty">This shop is no longer available.</div>
    {{else}}
        <div class="merchant-shop-pinned">
            <section class="merchant-shop-section merchant-shop-subject">
                <div class="merchant-shop-subject-image"><img src="{{portraitImg}}" alt="{{shopName}}"></div>
                <div class="merchant-shop-subject-copy">
                    <div class="merchant-shop-kicker"><i class="{{kindIcon}}"></i> {{kindLabel}}</div>
                    <div class="merchant-shop-title">{{shopName}}</div>
                    <div class="merchant-shop-description">
                        {{itemCount}} in stock
                        {{#if hoursLabel}}<span class="merchant-shop-hours"><i class="fa-solid fa-clock"></i> {{hoursLabel}}</span>{{/if}}
                    </div>
                    {{#if hasDescription}}
                        {{!-- Triple-stache: this is enriched HTML, and it is GM-written
                              by construction — the field only exists in a GM-only
                              window. A failed enrich yields nothing rather than the raw
                              string, so there is no path where unescaped input lands
                              here. --}}
                        <div class="merchant-shop-blurb">{{{description}}}</div>
                    {{/if}}
                    {{#if overridden}}
                        {{!-- GM only. A shop disagreeing with its own schedule is
                              deliberate, but it should never be a mystery. --}}
                        <div class="merchant-shop-override">
                            <i class="fa-solid fa-hand"></i> Overriding the schedule until the next opening or closing hour
                        </div>
                    {{/if}}
                </div>
                {{#if isGM}}
                    <button type="button" class="merchant-shop-open-toggle{{#unless isOpen}} is-closed{{/unless}}"
                            data-action="toggleOpen"
                            data-tooltip="{{#if isOpen}}Open for business — click to close{{else}}Closed — click to open{{/if}}">
                        <i class="fa-solid {{#if isOpen}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
                        {{#if isOpen}}Open{{else}}Closed{{/if}}
                    </button>
                {{/if}}
            </section>

            {{#if browsing}}
                {{!-- A player at a closed shop is browsing, and should be told so
                      rather than left wondering why nothing works. --}}
                <div class="merchant-shop-browsing">
                    <i class="fa-solid fa-door-closed"></i>
                    <span>Closed &mdash; you can look through the window, but nothing is changing hands.</span>
                </div>
            {{/if}}

            <section class="merchant-shop-section merchant-shop-actor">
                <div class="merchant-shop-actor-image"><img src="{{recipientImg}}" alt=""></div>
                <div class="merchant-shop-actor-copy">
                    <small>Buying as</small>
                    {{#if hasRecipient}}
                        <strong>{{recipientName}}</strong>
                    {{else}}
                        <strong class="merchant-shop-warning">No character available</strong>
                    {{/if}}
                </div>
                {{#if purseLabel}}
                    <div class="merchant-shop-purse" data-tooltip="What this character is carrying">
                        <i class="fa-solid fa-coins"></i> {{purseLabel}}
                    </div>
                {{/if}}
                {{#if hasRecipientChoice}}
                    <button type="button" class="blacksmith-window-btn-secondary merchant-shop-icon-btn"
                            data-action="changeRecipient" data-tooltip="Buy as a different character">
                        <i class="fa-solid fa-repeat"></i>
                    </button>
                {{/if}}
            </section>

            {{#if hasShelves}}
                {{!-- Last in the pinned block, so it reads as "filter what is below"
                      and stays put while the stock scrolls under it. --}}
                <section class="merchant-shop-section merchant-shop-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" placeholder="Search this shop" aria-label="Search stock"
                           data-shop-search autocomplete="off" spellcheck="false">
                    <button type="button" class="merchant-shop-search-clear" data-shop-search-clear
                            data-tooltip="Clear the search" hidden>
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </section>
            {{/if}}
        </div>

        <div class="merchant-shop-columns">
            <div class="merchant-shop-stock">
        {{#if hasShelves}}
            {{#each shelves}}
                <section class="merchant-shop-section merchant-shop-shelf{{#if hidden}} merchant-shop-shelf-hidden{{/if}}">
                    <h3>
                        <span><img class="merchant-shop-shelf-icon" src="{{img}}" alt="">{{label}}</span>
                        <span class="merchant-shop-head-actions">
                            {{#if canToggle}}
                                {{!-- GM only. The shop is where you are standing when
                                      you decide to bring the good stuff out. --}}
                                <button type="button" class="merchant-shop-shelf-toggle{{#if hidden}} is-hidden{{/if}}"
                                        data-action="toggleShelf" data-shelf-id="{{id}}"
                                        data-tooltip="{{#if hidden}}Hidden from players — click to bring it out front{{else}}On display — click to put it away{{/if}}">
                                    <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
                                    {{#if hidden}}Hidden{{else}}Shown{{/if}}
                                </button>
                            {{/if}}
                            {{#if isBarter}}
                                <span class="merchant-shop-hidden-tag" data-tooltip="No fixed price; settle it at the table">
                                    <i class="fa-solid fa-comments"></i> Barter
                                </span>
                            {{/if}}
                            {{#if canStock}}
                                <button type="button" class="merchant-shop-shelf-add" data-action="addToShelf" data-shelf-id="{{id}}"
                                        data-tooltip="Open compendium search — drag a result onto this shelf">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            {{/if}}
                            <span class="merchant-shop-count">{{count}}</span>
                        </span>
                    </h3>

                    {{!-- Drop target for the GM: drag stock straight onto the shelf
                          it belongs on. --}}
                    <div class="merchant-shop-shelf-body"{{#if canStock}} data-drop-shelf="{{id}}"{{/if}}>
                        {{#if hasItems}}
                            {{#each categories}}
                                <div class="merchant-shop-category">
                                    <h4><i class="{{icon}}"></i> {{label}}</h4>
                                    <div class="merchant-shop-item-list">
                                        {{#each items}}
                                            {{> "modules/coffee-pub-merchant/templates/partial-shop-row.hbs" this}}
                                        {{/each}}
                                    </div>
                                </div>
                            {{/each}}
                        {{else}}
                            <div class="merchant-shop-empty">
                                {{#if canStock}}Nothing on this shelf. Drag items here, or use the + above.{{else}}Nothing on this shelf.{{/if}}
                            </div>
                        {{/if}}
                    </div>
                </section>
            {{/each}}
            {{!-- Shown by the filter, never by the context: whether a search matches
                  is a question about the rendered list, not about the merchant. --}}
            <section class="merchant-shop-section merchant-shop-no-matches" data-shop-no-matches hidden>
                <div class="merchant-shop-empty">Nothing here matches that.</div>
            </section>
        {{else}}
            <section class="merchant-shop-section">
                <div class="merchant-shop-empty">This merchant has no shelves set up.</div>
            </section>
        {{/if}}
            </div>

            {{#if hasShelves}}
                {{!-- To the right of the stock, where a shopper expects it, and sticky
                      so it stays in view while the list scrolls under it. It wraps
                      underneath on a narrow window — see the flex-basis rules. --}}
                <aside class="merchant-shop-cart-column">
                    <section class="merchant-shop-section merchant-shop-cart">
                        <h3>
                            <span><i class="fa-solid fa-cart-shopping"></i> Cart</span>
                            <span class="merchant-shop-head-actions">
                                {{#if hasCart}}
                                    <button type="button" class="merchant-shop-cart-clear" data-action="clearCart"
                                            data-tooltip="Empty the cart">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                {{/if}}
                                <span class="merchant-shop-count">{{cartCount}}</span>
                            </span>
                        </h3>

                        {{#if hasCart}}
                            <div class="merchant-shop-cart-list">
                                {{#each cart}}
                                    <div class="merchant-shop-cart-line">
                                        <img src="{{img}}" alt="">
                                        <span class="merchant-shop-cart-name">{{name}}</span>
                                        <button type="button" class="merchant-shop-cart-remove" data-action="removeFromCart"
                                                data-item-id="{{id}}" data-tooltip="Take it out of the cart">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                        <span class="merchant-shop-cart-meta">
                                            <span class="merchant-shop-cart-qty">&times;{{quantity}}</span>
                                            <span class="merchant-shop-cart-total">{{totalLabel}}</span>
                                        </span>
                                    </div>
                                {{/each}}
                            </div>

                            <div class="merchant-shop-cart-foot">
                                <span>Total <strong>{{cartTotalLabel}}</strong></span>
                                <button type="button" class="blacksmith-window-btn-primary merchant-shop-checkout"
                                        data-action="checkout">
                                    <i class="fa-solid fa-coins"></i> Checkout
                                </button>
                            </div>
                        {{else}}
                            {{!-- Rendered empty rather than hidden, so the stock list
                                  does not reflow the moment a first item is added. --}}
                            <div class="merchant-shop-empty merchant-shop-cart-empty">
                                <i class="fa-solid fa-cart-shopping"></i>
                                <span>Nothing in the cart yet.</span>
                            </div>
                        {{/if}}
                    </section>
                    {{#if canSell}}
                        {{!-- Under the cart, and a drop target: drag something off a
                              character sheet to sell it. The button is the same path
                              for anyone who would rather not drag. --}}
                        <section class="merchant-shop-section merchant-shop-basket" data-drop-sell>
                            <h3>
                                <span><i class="fa-solid fa-hand-holding-dollar"></i> Selling</span>
                                <span class="merchant-shop-head-actions">
                                    {{#if hasBasket}}
                                        <button type="button" class="merchant-shop-cart-clear" data-action="clearBasket"
                                                data-tooltip="Empty the basket">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    {{/if}}
                                    <span class="merchant-shop-count">{{basketCount}}</span>
                                </span>
                            </h3>

                            {{#if hasBasket}}
                                <div class="merchant-shop-cart-list">
                                    {{#each basket}}
                                        <div class="merchant-shop-cart-line">
                                            <img src="{{img}}" alt="">
                                            <span class="merchant-shop-cart-name">{{name}}</span>
                                            <button type="button" class="merchant-shop-cart-remove" data-action="removeFromBasket"
                                                    data-item-id="{{id}}" data-tooltip="Take it out of the basket">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                            <span class="merchant-shop-cart-meta">
                                                <span class="merchant-shop-cart-qty">&times;{{quantity}}</span>
                                                <span class="merchant-shop-cart-total">{{totalLabel}}</span>
                                            </span>
                                        </div>
                                    {{/each}}
                                </div>

                                <div class="merchant-shop-cart-foot">
                                    <span>You get <strong>{{basketTotalLabel}}</strong></span>
                                    <button type="button" class="blacksmith-window-btn-primary merchant-shop-checkout"
                                            data-action="sellBasket">
                                        <i class="fa-solid fa-hand-holding-dollar"></i> Sell
                                    </button>
                                </div>
                            {{else}}
                                <div class="merchant-shop-empty merchant-shop-cart-empty">
                                    <i class="fa-solid fa-hand-holding-dollar"></i>
                                    <span>Drag something here to sell it.</span>
                                    <button type="button" class="blacksmith-window-btn-secondary merchant-shop-basket-pick"
                                            data-action="sell" {{#unless sellEnabled}}disabled{{/unless}}
                                            data-tooltip="{{sellTooltip}}">
                                        Or choose from your pack
                                    </button>
                                </div>
                            {{/if}}
                        </section>
                    {{/if}}
                </aside>
            {{/if}}
        </div>
    {{/if}}
</div>
