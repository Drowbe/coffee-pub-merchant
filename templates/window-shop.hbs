<div class="merchant-shop-content">
    {{#if busyLabel}}
        {{!-- Zero-height sticky rail: the panel floats over the dimmed list and does
              not scroll away, without competing for top: 0 with the pinned header. --}}
        <div class="merchant-shop-working" role="status" aria-live="polite">
            <div class="merchant-shop-working-panel">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span>{{busyLabel}}&hellip;</span>
            </div>
        </div>
    {{/if}}
    {{#if missing}}
        <div class="merchant-shop-empty">{{localize "coffee-pub-merchant.shop.unavailable"}}</div>
    {{else}}
        <div class="merchant-shop-columns">
            {{!-- Everything the shop is and everything it sells, in one
                  column. The cart sits beside the whole of it rather than
                  beneath the header, and the only thing spanning both is
                  the action bar in the footer. --}}
            <div class="merchant-shop-main">
                <section class="merchant-shop-section merchant-shop-subject"{{#if illustration}} data-has-illustration style="--merchant-shop-illustration: url('{{illustration}}')"{{/if}}>
                    {{!-- Who and what, across the top; anything the GM wrote spans the
                          full width beneath it, where a paragraph has room to be one
                          rather than a column squeezed beside a portrait. --}}
                    <div class="merchant-shop-subject-head">
                        <div class="merchant-shop-subject-image"><img src="{{portraitImg}}" alt="{{shopName}}"></div>
                        <div class="merchant-shop-subject-copy">
                            {{!-- Name and whether the door is open at either end of one
                                  line; who runs it and what it is beneath, each running
                                  the full width.

                                  The kind used to sit above the name as a kicker, which
                                  read as the more important of the two — it is a fact
                                  about the shop, not its billing. --}}
                            <div class="merchant-shop-titleline">
                                <div class="merchant-shop-title">{{shopName}}</div>
                                {{#if isGM}}
                                    <button type="button" class="merchant-shop-open-toggle{{#unless isOpen}} is-closed{{/unless}}"
                                            data-action="toggleOpen"
                                            data-tooltip="{{#if isOpen}}Open for business — click to close{{else}}Closed — click to open{{/if}}">
                                        <i class="fa-solid {{#if isOpen}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
                                        {{#if isOpen}}Open{{else}}Closed{{/if}}
                                    </button>
                                {{else}}
                                    <span class="merchant-shop-open-state{{#unless isOpen}} is-closed{{/unless}}">
                                        <i class="fa-solid {{#if isOpen}}fa-door-open{{else}}fa-door-closed{{/if}}"></i>
                                        {{#if isOpen}}Open{{else}}Closed{{/if}}
                                    </span>
                                {{/if}}
                            </div>
                            {{#if hasKeeper}}<div class="merchant-shop-keeper">{{keeperName}}</div>{{/if}}
                            <div class="merchant-shop-description">
                                <span><i class="{{kindIcon}}"></i> {{kindLabel}}</span>
                                {{#if hoursLabel}}<span><i class="fa-solid fa-clock"></i> {{hoursLabel}}</span>{{/if}}
                                {{!-- Said only where it is true. A bill twice what you
                                      expected is the town, not the shopkeeper, and a
                                      player should be able to tell which. --}}
                                {{#if marketLabel}}<span><i class="fa-solid fa-scale-balanced"></i> {{marketLabel}}</span>{{/if}}
                            </div>
                        </div>
                    </div>

                    {{#if hasDescription}}
                        {{!-- Triple-stache: this is enriched HTML, and it is GM-written
                              by construction — the field only exists in a GM-only
                              window. A failed enrich yields nothing rather than the raw
                              string, so there is no path where unescaped input lands
                              here. --}}
                        <div class="merchant-shop-blurb">{{{description}}}</div>
                    {{/if}}
                    {{#if overridden}}
                        {{!-- GM only. A shop disagreeing with its own schedule is
                              deliberate, but it should never be a mystery. --}}
                        <div class="merchant-shop-override">
                            <i class="fa-solid fa-hand"></i> {{localize "coffee-pub-merchant.shop.overriding"}}
                        </div>
                    {{/if}}

                    {{!-- Who is shopping, and who else is here. Inside the shop's own
                          card and under a rule: it is a fact about this visit rather
                          than a section in its own right, and the window is short of
                          vertical room that the stock and the slate both want more
                          than this does. --}}
                    <div class="merchant-shop-actor">
                    {{!-- Everyone else with something on a slate in this shop. The same bar
                          Curator puts looters in, for the same reason: a shop with three
                          people in it should look like one. Clicking a face switches to
                          that slate, which is the whole point of the slates being shared --
                          the GM sees who is mid-purchase and goes straight to them. --}}
                    {{#if hasShoppers}}
                        <div class="merchant-shop-shoppers">
                            {{#each shoppers}}
                                {{#if canSwitch}}
                                    <button type="button" class="merchant-shop-shopper{{#if lines}} has-slate{{/if}}"
                                            data-action="switchTo" data-actor-uuid="{{uuid}}"
                                            data-tooltip="{{tooltip}}">
                                        <img src="{{img}}" alt="{{name}}">
                                    </button>
                                {{else}}
                                    {{!-- A face you cannot act as is a portrait, not a
                                          control. Everybody sees who is here; only somebody
                                          who could shop as them can take the slate over. --}}
                                    <div class="merchant-shop-shopper is-static{{#if lines}} has-slate{{/if}}"
                                         data-tooltip="{{tooltip}}">
                                        <img src="{{img}}" alt="{{name}}">
                                    </div>
                                {{/if}}
                            {{/each}}
                        </div>
                        <div class="merchant-shop-shoppers-divider" aria-hidden="true"></div>
                    {{/if}}
                    <div class="merchant-shop-actor-image"><img src="{{recipientImg}}" alt=""></div>
                    <div class="merchant-shop-actor-copy">
                        <small>{{localize "coffee-pub-merchant.shop.buyingAs"}}</small>
                        {{#if hasRecipient}}
                            <strong>{{recipientName}}</strong>
                        {{else}}
                            <strong class="merchant-shop-warning">{{localize "coffee-pub-merchant.shop.noCharacter"}}</strong>
                        {{/if}}
                    </div>
                    {{#if hasRecipientChoice}}
                        <button type="button" class="blacksmith-window-btn-secondary merchant-shop-icon-btn"
                                data-action="changeRecipient" data-tooltip="{{localize "coffee-pub-merchant.shop.switchTooltip"}}">
                            <i class="fa-solid fa-user-group-simple"></i>
                        </button>
                    {{/if}}
                    </div>
                    {{!-- Where this party stands here, under who is doing the
                          shopping — because it is a fact about *this visit by these
                          people*, not a setting. Only when the shop has opted in and
                          there is something to say. --}}
                    {{#if reputationLine}}
                        <div class="merchant-shop-reputation" data-tooltip="{{reputationTooltip}}">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                            {{!-- Triple-stache: the sentence arrives with its two
                                  values already wrapped in <strong> and already
                                  escaped. See `_reputationSentence`. --}}
                            <span>{{{reputationSentence}}}</span>
                        </div>
                    {{/if}}
                </section>

            {{#if browsing}}
                {{!-- A player at a closed shop is browsing, and should be told so
                      rather than left wondering why nothing works. --}}
                <div class="merchant-shop-browsing">
                    <i class="fa-solid fa-door-closed"></i>
                    <span>{{localize "coffee-pub-merchant.shop.closed"}}</span>
                </div>
            {{/if}}

            <div class="merchant-shop-stock">
        {{#if hasInventories}}
                {{!-- Which side of the counter you are on. It was a Sell button inside
                      the slate header, which put a control that changes what the *stock*
                      column shows into the panel that shows the result -- and left no
                      way back except pressing it again and knowing that it toggled.
                      Two buttons, one of them lit, says where you are as well as what
                      you can do. --}}
                {{#if canSell}}
                    <section class="merchant-shop-section merchant-shop-sides">
                        <button type="button" class="merchant-shop-side{{#unless sell.open}} is-on{{/unless}}"
                                data-action="showBuy" data-tooltip="{{localize "coffee-pub-merchant.shop.browseTooltip"}}">
                            <i class="fa-solid fa-basket-shopping"></i> {{localize "coffee-pub-merchant.shop.buyTab"}}
                        </button>
                        <button type="button" class="merchant-shop-side{{#if sell.open}} is-on{{/if}}"
                                data-action="showSell" {{#unless sellEnabled}}disabled{{/unless}}
                                data-tooltip="{{sellTooltip}}">
                            <i class="fa-solid fa-hand-holding-dollar"></i> {{localize "coffee-pub-merchant.shop.sellTab"}}
                        </button>
                    </section>
                {{/if}}

                {{!-- The pack's search, in the same slot as the shop's rather than
                      inside the pack itself. Two boxes, because they filter two
                      different piles and one box doing both would mean typing "rope" to
                      find yours and hiding half the shop as a side effect -- but one
                      *position*, because there is only one place a search belongs. --}}
                {{#if sell.open}}
                    <section class="merchant-shop-section merchant-shop-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" placeholder="{{localize "coffee-pub-merchant.shop.searchPack"}}" aria-label="{{localize "coffee-pub-merchant.shop.searchPackLabel"}}"
                               data-sell-search value="{{sell.search}}" autocomplete="off" spellcheck="false">
                    </section>
                {{/if}}

                {{!-- Pinned to the top of the stock column: it belongs to the list it
                      filters, not to the window, and stays put while that list scrolls
                      under it. --}}
                <section class="merchant-shop-section merchant-shop-search{{#if sell.open}} is-hidden{{/if}}">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" placeholder="{{localize "coffee-pub-merchant.shop.searchStock"}}" aria-label="{{localize "coffee-pub-merchant.shop.searchStockLabel"}}"
                           data-shop-search autocomplete="off" spellcheck="false">
                    <button type="button" class="merchant-shop-search-clear" data-shop-search-clear
                            data-tooltip="{{localize "coffee-pub-merchant.shop.clearSearch"}}" hidden>
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </section>

                {{!-- The scrolling region starts here, below the search, so the
                      scrollbar does not run up behind a box that never moves. --}}
                {{!-- The pack is an inventory. Same section, same header, same body, same
                      row partial -- so it inherits the card, the spacing and the
                      scrolling rather than reimplementing three of them slightly
                      differently, which is what it was doing and what looked wrong.
                      One list is showing at a time, so one container holds it. --}}
                <div class="merchant-shop-inventories">
            {{#if sell.open}}
            <section class="merchant-shop-section merchant-shop-inventory">
                <h3>
                    <span><i class="fa-solid fa-hand-holding-dollar"></i> {{sell.title}}</span>
                    <span class="merchant-shop-head-actions">
                        <button type="button" class="merchant-shop-inventory-add"
                                data-action="sortSell" data-tooltip="{{sell.sortTooltip}}">
                            <i class="{{sell.sortIcon}}"></i>
                        </button>
                        <span class="merchant-shop-count">{{sell.count}}</span>
                    </span>
                </h3>
                <div class="merchant-shop-inventory-body">
                    {{#if sell.hasItems}}
                        {{#each sell.groups}}
                            <div class="merchant-shop-category">
                                {{#if label}}<h4><i class="{{icon}}"></i> {{label}}</h4>{{/if}}
                                <div class="merchant-shop-item-list">
                                    {{#each items}}
                                        {{> "modules/coffee-pub-merchant/templates/partial-shop-row.hbs" this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{/each}}
                    {{else}}
                        <div class="merchant-shop-empty">{{sell.emptyMessage}}</div>
                    {{/if}}
                </div>
            </section>
            {{else}}
            {{#each inventories}}
                <section class="merchant-shop-section merchant-shop-inventory{{#if hidden}} merchant-shop-inventory-hidden{{/if}}">
                    <h3>
                        <span><img class="merchant-shop-inventory-icon" src="{{img}}" alt="">{{label}}</span>
                        <span class="merchant-shop-head-actions">
                            {{#if canToggle}}
                                {{!-- GM only. The shop is where you are standing when
                                      you decide to bring the good stuff out. --}}
                                <button type="button" class="merchant-shop-inventory-toggle{{#if hidden}} is-hidden{{/if}}"
                                        data-action="toggleInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{#if hidden}}Hidden from players — click to bring it out front{{else}}On display — click to put it away{{/if}}">
                                    <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
                                    {{#if hidden}}Hidden{{else}}Shown{{/if}}
                                </button>
                            {{/if}}
                            {{#if isUnpricedInventory}}
                                <span class="merchant-shop-hidden-tag" data-tooltip="{{localize "coffee-pub-merchant.shop.negotiateTooltip"}}">
                                    <i class="fa-solid fa-comments"></i> {{localize "coffee-pub-merchant.shop.negotiate"}}
                                </span>
                            {{/if}}
                            {{#if canStock}}
                                <button type="button" class="merchant-shop-inventory-add" data-action="restockInventory"
                                        data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.shop.restockTooltip"}}">
                                    <i class="fa-solid fa-arrows-rotate"></i>
                                </button>
                                <button type="button" class="merchant-shop-inventory-add" data-action="addToInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.shop.compendiumTooltip"}}">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                                {{!-- Last, and the only one that asks first. Setting a
                                      count to zero says "sold out"; this says "take it
                                      all off and let me start again". --}}
                                <button type="button" class="merchant-shop-inventory-add merchant-shop-inventory-clear"
                                        data-action="clearInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.shop.clearInventoryTooltip"}}">
                                    <i class="fa-solid fa-broom"></i>
                                </button>
                            {{/if}}
                            <span class="merchant-shop-count">{{count}}</span>
                        </span>
                    </h3>

                    {{!-- Drop target for the GM: drag stock straight onto the inventory
                          it belongs on. --}}
                    <div class="merchant-shop-inventory-body"{{#if canStock}} data-drop-inventory="{{id}}"{{/if}}>
                        {{#if hasItems}}
                            {{#each categories}}
                                <div class="merchant-shop-category">
                                    <h4><i class="{{icon}}"></i> {{label}}</h4>
                                    <div class="merchant-shop-item-list">
                                        {{#each items}}
                                            {{> "modules/coffee-pub-merchant/templates/partial-shop-row.hbs" this}}
                                        {{/each}}
                                    </div>
                                </div>
                            {{/each}}
                        {{else}}
                            <div class="merchant-shop-empty">
                                {{#if canStock}}Nothing on this inventory. Drag items here, or use the + above.{{else}}Nothing on this inventory.{{/if}}
                            </div>
                        {{/if}}
                    </div>
                </section>
            {{/each}}
            {{/if}}
            {{!-- Shown by the filter, never by the context: whether a search matches
                  is a question about the rendered list, not about the merchant. --}}
            <section class="merchant-shop-section merchant-shop-no-matches" data-shop-no-matches hidden>
                <div class="merchant-shop-empty">{{localize "coffee-pub-merchant.shop.noMatches"}}</div>
            </section>
                </div>
        {{else}}
            <section class="merchant-shop-section">
                <div class="merchant-shop-empty">{{localize "coffee-pub-merchant.shop.noInventories"}}</div>
            </section>
        {{/if}}
            </div>{{!-- /stock --}}
        </div>{{!-- /main --}}

            {{#if hasInventories}}
                {{!-- One slate, two segments.
                      "Slate" rather than "cart": a slate is a running reckoning you
                      settle and then wipe, which is what this is and what a cart is
                      not. Buying and selling are one settlement, so they are one panel
                      with one total rather than two buckets with two. It also means
                      the *whole* panel is the drop target: an item off a character
                      sheet can only be sold, so aiming at a sub-panel was asking the
                      user to know something the panel already knows. --}}
                <aside class="merchant-shop-cart-column" data-drop-sell>
                    <section class="merchant-shop-section merchant-shop-cart">
                        {{!-- Pinned, so the total is on screen however long the list
                              gets. A total you have to scroll to find is a total you
                              stop trusting. --}}
                        <header class="merchant-shop-cart-head">
                            <div class="merchant-shop-cart-headline">
                                {{!-- Whose slate, with a face on it. A slate belongs to
                                      a character rather than to whoever is looking at
                                      it, and clicking somebody's portrait on the bar
                                      swaps the whole panel underneath you -- so the
                                      panel says whose it now is. --}}
                                <span class="merchant-shop-cart-title">
                                    {{#if hasRecipient}}
                                        <img class="merchant-shop-cart-portrait" src="{{recipientImg}}" alt=""
                                             data-tooltip="{{recipientName}}'s slate">
                                        <span>{{recipientName}}</span>
                                    {{else}}
                                        <i class="fa-solid fa-scroll"></i> <span>{{localize "coffee-pub-merchant.shop.slate"}}</span>
                                    {{/if}}
                                </span>
                            </div>

                            {{!-- Labels in one column, figures in another, so the eye
                                  runs down each rather than zig-zagging between them.
                                  The total is the answer and sits apart from its two
                                  workings. --}}
                            <dl class="merchant-shop-cart-sums">
                                {{!-- What is in the purse before any of this, so the
                                      total below can be read against something. --}}
                                <div class="merchant-shop-cart-sum">
                                    <dt>{{localize "coffee-pub-merchant.shop.funds"}}</dt>
                                    <dd>{{fundsLabel}}</dd>
                                </div>
                                {{!-- Signed the way they act on that purse: buying
                                      takes, selling gives. --}}
                                <div class="merchant-shop-cart-sum">
                                    <dt>{{localize "coffee-pub-merchant.shop.buyingTotal"}}</dt>
                                    <dd>&minus;{{cartTotalLabel}}</dd>
                                </div>
                                <div class="merchant-shop-cart-sum">
                                    <dt>{{localize "coffee-pub-merchant.shop.sellingTotal"}}</dt>
                                    <dd>+{{basketTotalLabel}}</dd>
                                </div>
                                <div class="merchant-shop-cart-sum merchant-shop-cart-sum-net merchant-shop-cart-net-{{netDirection}}">
                                    <dt>{{localize "coffee-pub-merchant.shop.total"}}</dt>
                                    <dd>{{netTotalLabel}}</dd>
                                </div>
                            </dl>
                        </header>

                        {{!-- Likewise: the scroller starts below the total. --}}
                        <div class="merchant-shop-cart-body">
                        {{#if hasAnything}}
                            {{#if hasCart}}
                                <div class="merchant-shop-cart-segment">
                                    <h4><span><i class="fa-solid fa-basket-shopping"></i> {{localize "coffee-pub-merchant.shop.buyingSegment"}}</span></h4>
                                    <div class="merchant-shop-cart-list">
                                        {{#each cart}}
                                            {{> "modules/coffee-pub-merchant/templates/partial-slate-line.hbs" this}}
                                        {{/each}}
                                    </div>
                                </div>
                            {{/if}}

                            {{#if hasBasket}}
                                <div class="merchant-shop-cart-segment merchant-shop-cart-selling">
                                    <h4><span><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "coffee-pub-merchant.shop.sellingSegment"}}</span></h4>
                                    <div class="merchant-shop-cart-list">
                                        {{#each basket}}
                                            {{> "modules/coffee-pub-merchant/templates/partial-slate-line.hbs" this}}
                                        {{/each}}
                                    </div>
                                </div>
                            {{/if}}
                        {{else}}
                            <div class="merchant-shop-empty merchant-shop-cart-empty">
                                <i class="fa-solid fa-scroll"></i>
                                <span>{{localize "coffee-pub-merchant.shop.slateEmpty"}}</span>
                                {{#if canSell}}
                                    {{!-- No button here: Sell is in the header above,
                                          where it is reachable whether the slate is
                                          empty or not. --}}
                                    <span class="merchant-shop-cart-hint">{{localize "coffee-pub-merchant.shop.dragToSell"}}</span>
                                {{/if}}
                            </div>
                        {{/if}}
                        </div>
                    </section>
                </aside>
            {{/if}}
        </div>
    {{/if}}
</div>
