{{!--
    One rate, as a labelled row.

        MARKUP
        −90%  [══════╪════●═══]  +200%   │ 200% markup │

    **The bounds are percentages, not multipliers.** ×1.20 is how it is stored; "20%
    markup" is what a shopkeeper is deciding, and only one of those two is read at a
    glance. The channel is red below list price and green above it, so which side of
    neutral the handle sits on is legible before any number is.

    Used for the shop's Global Markup and for every inventory rate, so the three read
    the same and are bound by the same code.
--}}
<div class="merchant-config-row merchant-config-rate" data-rate-row
     {{#if safe}}data-rate-safe="{{safe}}" data-rate-worst="{{worstCase}}"{{/if}}>
    <span class="merchant-config-label">{{label}}</span>
    <div class="merchant-config-rate-track">
        <span class="merchant-config-rate-bound">{{minLabel}}</span>
        <div class="merchant-config-rate-slider" style="--merchant-rate-neutral: {{neutralPercent}}">
            <input type="range" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}"
                   data-rate-kind="{{kind}}" {{#if inventoryId}}data-inventory-{{field}}="{{inventoryId}}"{{else}}data-merchant-markup{{/if}}
                   aria-label="{{label}}">
        </div>
        <span class="merchant-config-rate-bound">{{maxLabel}}</span>
        <output class="merchant-config-rate-value" data-rate-readout>{{readout}}</output>
    </div>
    {{!-- Under the hint, not instead of it. The hint says what the control is for and
          is always true; this says what the current setting does and is only sometimes
          there, so replacing one with the other would lose the constant to the
          occasional. --}}
    {{#if hint}}<small class="merchant-config-hint">{{hint}}</small>{{/if}}
    {{#if warning}}
        <small class="merchant-config-hint merchant-config-rate-warning" data-rate-warning
               {{#unless warned}}hidden{{/unless}}>{{warning}}</small>
    {{/if}}
</div>
