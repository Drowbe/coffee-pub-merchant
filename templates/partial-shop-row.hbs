{{!--
    One stock row. Every flag it needs is precomputed on the row itself so the
    partial never reaches for parent context.
--}}
<div class="merchant-shop-item" data-item-id="{{id}}">
    <img src="{{img}}" alt="">
    <div class="merchant-shop-item-copy">
        <strong>{{name}}</strong>
        <span>
            {{typeLabel}}
            {{#if priceLabel}}<em class="merchant-shop-price">{{priceLabel}}</em>{{/if}}
            {{#if unpriced}}<em class="merchant-shop-unpriced" data-tooltip="Set a price, or move it to a barter shelf">no price</em>{{/if}}
        </span>
    </div>
    {{#if busy}}
        <div class="merchant-shop-row-actions">
            <span class="merchant-shop-blocked"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
        </div>
    {{else if isBarter}}
        <div class="merchant-shop-row-actions">
            <span class="merchant-shop-blocked" data-tooltip="No fixed price; ask the merchant">
                <i class="fa-solid fa-comments"></i> Ask
            </span>
        </div>
    {{else}}
        <div class="merchant-shop-row-actions">
            {{#if canBuy}}
                <button type="button" class="blacksmith-window-btn-secondary merchant-shop-buy" data-action="buy" data-item-id="{{id}}"
                        data-tooltip="Buy this">
                    <i class="fa-solid fa-coins"></i> {{priceLabel}}
                </button>
            {{/if}}
            <button type="button" class="blacksmith-window-btn-secondary merchant-shop-icon-btn" data-action="acquire" data-item-id="{{id}}"
                    {{#unless canAcquire}}disabled{{/unless}} data-tooltip="Take without paying">
                <i class="fa-solid fa-hand"></i>
            </button>
            <button type="button" class="blacksmith-window-btn-secondary merchant-shop-icon-btn" data-action="give" data-item-id="{{id}}"
                    {{#unless canGive}}disabled{{/unless}} data-tooltip="Send to another party member">
                <i class="fa-solid fa-hand-holding-heart"></i>
            </button>
            <button type="button" class="blacksmith-window-btn-secondary merchant-shop-icon-btn" data-action="party" data-item-id="{{id}}"
                    {{#unless canParty}}disabled{{/unless}} data-tooltip="Send to the party inventory">
                <i class="fa-solid fa-users"></i>
            </button>
        </div>
    {{/if}}
</div>
