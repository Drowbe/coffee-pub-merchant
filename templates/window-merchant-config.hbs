{{!--
    Merchant Settings.

    **Every setting is a labelled pair, never a sentence.** There used to be controls
    embedded in prose — "every [4] days", "[25] products [3] each" — which asks the
    reader to parse a sentence to find out what a box does, and leaves nothing to
    align. A label in one column and its control in the next can be scanned down.

    Saving is live. The Saved pip in the title row is the feedback for that; the
    footer's primary button closes rather than commits, because there is nothing
    outstanding to commit.
--}}
<div class="merchant-config-content">

    {{!-- The subject card carries the toggle, because whether this Actor is a shop at
          all is the biggest fact on the screen and belongs with its name. --}}
    <section class="merchant-config-section merchant-config-subject">
        {{!-- The portrait is the control. It is already the thing on screen that means
              "this shopkeeper", so it is the honest place to put the way to change one —
              and it changes the prototype token with it, because a sheet and a token that
              disagree are two characters as far as the table is concerned. --}}
        <button type="button" class="merchant-config-image" data-merchant-portrait
                data-tooltip="{{localize "coffee-pub-merchant.config.portraitTooltip"}}">
            <img src="{{portraitImg}}" alt="{{actorName}}">
        </button>
        <div class="merchant-config-copy">
            <div class="merchant-config-kicker">{{localize "coffee-pub-merchant.config.title"}}</div>
            <div class="merchant-config-title">{{actorName}}</div>
        </div>
        <label class="merchant-config-enable{{#if enabled}} is-on{{/if}}"
               data-tooltip="{{localize "coffee-pub-merchant.config.isMerchantTooltip"}}">
            <input type="checkbox" data-merchant-enabled {{#if enabled}}checked{{/if}}>
            <span>{{localize "coffee-pub-merchant.config.isMerchant"}}</span>
        </label>
    </section>

    {{#if enabled}}
        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-store"></i> {{localize "coffee-pub-merchant.config.theShop"}}</span>
            </h3>

            <div class="merchant-config-grid">
                <label class="merchant-config-row">
                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.shopName"}}</span>
                    <input type="text" value="{{shopName}}" placeholder="{{actorName}}" data-merchant-name>
                    <small class="merchant-config-hint">{{localize "coffee-pub-merchant.config.shopNameHint"}}</small>
                </label>

                {{!-- A path, browsable or typed. Typed matters: a path pasted from
                      somewhere else is a real way to set one, and blank is how it is
                      cleared — a browse-only field has no way to say "none". --}}
                <label class="merchant-config-row">
                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.illustration"}}</span>
                    <div class="merchant-config-file merchant-config-tint">
                        <input type="text" value="{{illustration}}" data-merchant-illustration
                               placeholder="{{localize "coffee-pub-merchant.config.illustrationPlaceholder"}}">
                        <button type="button" class="merchant-config-file-browse"
                                data-merchant-illustration-browse
                                data-tooltip="{{localize "coffee-pub-merchant.config.illustrationBrowse"}}">
                            <i class="fa-solid fa-file-image"></i>
                        </button>
                        {{!-- The tint rides on the end of the illustration row because it
                              is the same question about the same card -- what this place
                              looks like -- and a row of its own said it was a third thing.
                              Typed as well as picked: a hex pasted from wherever the GM
                              keeps their palette is a real way to set one, and blank is
                              how it is cleared. The swatch opens on the card's own leather
                              when there is no tint, so it starts somewhere sane rather
                              than on a black nobody chose. --}}
                        <input type="text" value="{{tint}}" data-merchant-tint spellcheck="false"
                               placeholder="{{localize "coffee-pub-merchant.config.tintPlaceholder"}}"
                               data-tooltip="{{localize "coffee-pub-merchant.config.tint"}}"
                               aria-label="{{localize "coffee-pub-merchant.config.tint"}}">
                        <input type="color" value="{{tintSwatch}}" data-merchant-tint-swatch
                               data-tooltip="{{localize "coffee-pub-merchant.config.tint"}}"
                               aria-label="{{localize "coffee-pub-merchant.config.tint"}}">
                        <button type="button" class="merchant-config-file-browse" data-merchant-tint-clear
                                data-tooltip="{{localize "coffee-pub-merchant.config.tintClear"}}"
                                {{#unless tint}}disabled{{/unless}}>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <small class="merchant-config-hint">{{localize "coffee-pub-merchant.config.illustrationHint"}}</small>
                </label>

                <label class="merchant-config-row">
                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.kind"}}</span>
                    <select data-merchant-kind>
                        {{#each kindOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <small class="merchant-config-hint">{{localize "coffee-pub-merchant.config.kindHint"}}</small>
                </label>

                <label class="merchant-config-row merchant-config-row-tall">
                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.description"}}</span>
                    <textarea data-merchant-description rows="3"
                              placeholder="{{localize "coffee-pub-merchant.config.descriptionPlaceholder"}}">{{description}}</textarea>
                    <small class="merchant-config-hint">{{localize "coffee-pub-merchant.config.descriptionHint"}}</small>
                </label>
            </div>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-clock"></i> {{localize "coffee-pub-merchant.config.tradingHours"}}</span>
                <span class="merchant-config-hours-always{{#if alwaysClosed}} is-closed{{/if}}"
                      data-hours-badge {{#unless hoursBadge}}hidden{{/unless}}>{{hoursBadge}}</span>
            </h3>

            <div class="merchant-config-grid">
                <div class="merchant-config-row">
                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.open"}}</span>
                    <div class="merchant-config-hours">
                        <div class="merchant-config-hours-row">
                            <span class="merchant-config-hours-bound">{{dayStartLabel}}</span>
                            <div class="merchant-config-hours-slider" data-hours-slider>
                                <div class="merchant-config-hours-fill" data-hours-fill></div>
                                <input type="range" min="0" max="{{maxHour}}" step="1" value="{{openHour}}" data-hours-open aria-label="{{localize "coffee-pub-merchant.config.openingHour"}}">
                                <input type="range" min="0" max="{{dayEnd}}" step="1" value="{{closeHour}}" data-hours-close aria-label="{{localize "coffee-pub-merchant.config.closingHour"}}">
                            </div>
                            <span class="merchant-config-hours-bound">{{dayEndLabel}}</span>
                            {{!-- Beside the track, where every other slider in this
                                  window puts its answer, rather than as a line of prose
                                  underneath. It used to be the odd one out: the eye
                                  lands at the end of the track after dragging, and the
                                  hours were the one control that had nothing there. --}}
                            <output class="merchant-config-hours-value" data-hours-readout>
                                <span data-hours-open-label>{{openLabel}}</span>–<span data-hours-close-label>{{closeLabel}}</span>
                            </output>
                        </div>
                    </div>
                </div>
            </div>

            {{#if overridden}}
                <div class="merchant-config-note">
                    {{localize "coffee-pub-merchant.config.overriding"}}
                </div>
            {{/if}}
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-sack-dollar"></i> {{localize "coffee-pub-merchant.config.theTill"}}</span>
                {{!-- What the coins below come to in total. It reads as a different
                      number from the boxes because it *is* one: everything converted
                      to the coins a price is quoted in, so 400 platinum shows up as
                      gold. Unlabelled it looked like a contradiction. --}}
                <span class="merchant-config-count merchant-config-till-total"
                      data-tooltip="{{localize "coffee-pub-merchant.config.tillTooltip"}}">
                    Worth {{tillLabel}}
                </span>
            </h3>

            {{!-- Every denomination the system defines, pre-filled with what the shop
                  actually holds. It used to be a single gold box, which quietly said
                  the other four coins did not exist and could not show a shop its own
                  silver. --}}
            <div class="merchant-config-till">
                {{#each till}}
                    <label class="merchant-config-coin">
                        <span class="merchant-config-coin-label">{{label}}</span>
                        <input type="number" min="0" step="1" value="{{value}}"
                               data-merchant-coin="{{key}}" aria-label="{{label}} in the till">
                    </label>
                {{/each}}
            </div>
            <small class="merchant-config-hint">{{localize "coffee-pub-merchant.config.tillHint"}}</small>
            {{#if tillEmpty}}
                <div class="merchant-config-note is-warning">
                    {{localize "coffee-pub-merchant.config.tillEmpty"}}
                </div>
            {{/if}}
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-tags"></i> {{localize "coffee-pub-merchant.config.pricing"}}</span></h3>

            <div class="merchant-config-grid">
                {{> "modules/coffee-pub-merchant/templates/partial-rate.hbs" globalMarkup}}
            </div>
            <small class="merchant-config-hint">
                {{localize "coffee-pub-merchant.config.globalMarkupHint"}}
            </small>

            <label class="merchant-config-enable merchant-config-enable-inline{{#if reputationOn}} is-on{{/if}}">
                <input type="checkbox" data-merchant-reputation {{#if reputationOn}}checked{{/if}}>
                <span>{{localize "coffee-pub-merchant.config.reputationToggle"}}</span>
            </label>
            {{!-- One sentence, and only the range. **Where this party actually stands
                  belongs in the shop**, under who you are shopping as — it is a fact
                  about a visit, not a setting, and it was taking three lines in the
                  window where a GM is configuring rather than trading. --}}
            <small class="merchant-config-hint">
                Reputation can adjust prices from a {{reputationPenalty}} penalty to a
                {{reputationBenefit}} benefit.
            </small>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-layer-group"></i> {{localize "coffee-pub-merchant.config.inventories"}}</span>
                <span class="merchant-config-head-actions">
                    <button type="button" class="merchant-config-inventory-add merchant-config-inventory-add-wide"
                            data-action="addInventory"
                            data-tooltip="{{localize "coffee-pub-merchant.config.addInventoryHint"}}">
                        <i class="fa-solid fa-plus"></i>
                        <span>{{localize "coffee-pub-merchant.config.addInventory"}}</span>
                    </button>
                    <span class="merchant-config-count">{{inventoryCount}}</span>
                </span>
            </h3>

            {{!-- **Stated once, above the shelves.** These are world settings, so a copy
                  on every card repeated the same four lines five times and made each
                  shelf look like it owned them. Here it reads as what it is: the rules
                  every shelf below is playing by. --}}
            {{#if hasInventories}}
                <div class="merchant-config-note merchant-config-depth-summary">
                    <span>{{localize "coffee-pub-merchant.config.depthSummary"}}</span>
                    <span class="merchant-config-depth-row">{{depthByType}}</span>
                    <span class="merchant-config-depth-row">{{depthByRarity}}</span>
                    <span>{{localize "coffee-pub-merchant.config.depthWorldNote"}}</span>
                </div>

                {{#each inventories}}
                    {{!-- Each inventory is its own card with its own headings, so it
                          reads like the shop window rather than like a row in a table
                          that grew settings. --}}
                    <div class="merchant-config-inv"{{#if canRoll}} data-drop-table="{{id}}"{{/if}}>

                        {{!-- **The category is the heading; the name is content.** The
                              type is what this card *is* and cannot be changed, which
                              is what a heading says; the name is a thing the GM writes,
                              so it belongs in the card with the artwork it goes with. --}}
                        <h3 class="merchant-config-inv-head">
                            <span>
                                {{typeLabel}}
                                {{#if hidden}}
                                    <span class="merchant-config-inv-hidden"
                                          data-tooltip="{{localize "coffee-pub-merchant.config.hiddenTooltip"}}">
                                        <i class="fa-solid fa-eye-slash"></i> {{localize "coffee-pub-merchant.config.hiddenBadge"}}
                                    </span>
                                {{/if}}
                            </span>
                            <span class="merchant-config-head-actions">
                                {{#if canRoll}}
                                    <button type="button" class="merchant-config-inv-btn"
                                            data-action="restockInventory" data-inventory-id="{{id}}"
                                            data-tooltip="{{localize "coffee-pub-merchant.config.refillTooltip"}}">
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                    </button>
                                {{/if}}
                                <button type="button" class="merchant-config-inv-btn"
                                        data-action="openInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.config.openInventoryTooltip"}}">
                                    <i class="fa-solid fa-box-open"></i>
                                </button>
                                <button type="button" class="merchant-config-inv-btn"
                                        data-action="clearInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.config.clearInventoryTooltip"}}">
                                    <i class="fa-solid fa-broom"></i>
                                </button>
                                <button type="button" class="merchant-config-inv-btn merchant-config-remove"
                                        data-action="removeInventory" data-inventory-id="{{id}}"
                                        data-tooltip="{{localize "coffee-pub-merchant.config.removeInventoryTooltip"}}">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <span class="merchant-config-count"
                                      data-tooltip="{{count}} item{{#unless one}}s{{/unless}} on this inventory">{{count}}</span>
                            </span>
                        </h3>

                        <div class="merchant-config-inv-identity">
                            <button type="button" class="merchant-config-inventory-art"
                                    data-inventory-image="{{id}}"
                                    data-tooltip="{{localize "coffee-pub-merchant.config.artworkTooltip"}}">
                                <img src="{{img}}" alt="">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <input type="text" class="merchant-config-inventory-name" value="{{label}}"
                                   data-inventory-name="{{id}}" aria-label="{{localize "coffee-pub-merchant.config.inventoryName"}}"
                                   placeholder="{{typeLabel}}">
                        </div>

                        {{#if hasRates}}
                            <div class="merchant-config-inv-group">
                                <h4>{{localize "coffee-pub-merchant.config.pricing"}}</h4>
                                <div class="merchant-config-grid">
                                    {{#each rates}}
                                        {{> "modules/coffee-pub-merchant/templates/partial-rate.hbs" this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{/if}}
                        {{#if pricingNone}}
                            <div class="merchant-config-inv-group">
                                <h4>{{localize "coffee-pub-merchant.config.pricing"}}</h4>
                                <div class="merchant-config-note">
                                    {{localize "coffee-pub-merchant.config.pricingNone"}}
                                </div>
                            </div>
                        {{/if}}

                        {{#if canRoll}}
                            {{!-- **How many, as distinct from when.** These were inside
                                  Restock and read as part of that one decision, which is
                                  why the ceilings kept being taken for restock settings.
                                  Products is the number of lines this shelf carries and
                                  is the target a roll fills back up to; Max stack is how
                                  deep any one line goes. --}}
                            <div class="merchant-config-inv-group">
                                <h4>{{localize "coffee-pub-merchant.config.stocking"}}</h4>
                                <div class="merchant-config-restock">
                                    <label class="merchant-config-row merchant-config-restock-method">
                                        <span class="merchant-config-label"
                                              data-tooltip="{{localize "coffee-pub-merchant.config.depthTooltip"}}">{{localize "coffee-pub-merchant.config.depth"}}</span>
                                        <select data-inventory-depth="{{id}}" data-tooltip="{{depthHint}}">
                                            {{#each depthOptions}}
                                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                            {{/each}}
                                        </select>
                                    </label>

                                    <label class="merchant-config-row merchant-config-restock-stack"
                                           data-tooltip="{{localize "coffee-pub-merchant.config.productsTooltip"}}">
                                        <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.products"}}</span>
                                        <input type="number" min="1" max="999" step="1" value="{{maxProducts}}"
                                               data-inventory-max-products="{{id}}"
                                               aria-label="{{localize "coffee-pub-merchant.config.productsLabel"}}">
                                    </label>

                                    {{#if showMaxStack}}
                                        <label class="merchant-config-row merchant-config-restock-stack"
                                               data-tooltip="{{maxStackTooltip}}">
                                            <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.maxStack"}}</span>
                                            <input type="number" min="1" max="999" step="1" value="{{maxPerItem}}"
                                                   data-inventory-max-per-item="{{id}}"
                                                   aria-label="{{localize "coffee-pub-merchant.config.maxStackLabel"}}">
                                        </label>
                                    {{/if}}
                                </div>

                            </div>
                        {{/if}}

                        <div class="merchant-config-inv-group">
                            <h4>{{localize "coffee-pub-merchant.config.restock"}}</h4>
                            {{#if canRoll}}
                                {{!-- One row: what happens, how often, and how deep it
                                      stacks are one decision made in one glance. They
                                      wrap when the window is narrow rather than
                                      squeezing, and Frequency is simply absent on a
                                      method that has no cadence. --}}
                                <div class="merchant-config-restock">
                                    <label class="merchant-config-row merchant-config-restock-method">
                                        <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.method"}}</span>
                                        <select data-inventory-stock="{{id}}">
                                            {{#each stockOptions}}
                                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                            {{/each}}
                                        </select>
                                    </label>

                                    {{#if restocking}}
                                        <label class="merchant-config-row">
                                            <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.frequency"}}</span>
                                            <select data-inventory-frequency="{{id}}">
                                                {{#each frequencyOptions}}
                                                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                                {{/each}}
                                            </select>
                                        </label>
                                    {{/if}}

                                </div>
                            {{else}}
                                <div class="merchant-config-note">
                                    {{localize "coffee-pub-merchant.config.purchasedNote"}}
                                </div>
                            {{/if}}
                        </div>

                        {{#if canRoll}}
                            {{!-- **Where new products come from.** A table is a list
                                  somebody wrote; a query is a description of what this
                                  shop deals in, answered against what is installed right
                                  now. One or the other, because they answer the same
                                  question and a shelf drawing from both twice over is a
                                  shelf nobody can predict. --}}
                            <div class="merchant-config-inv-group">
                                <h4>{{localize "coffee-pub-merchant.config.newStock"}}</h4>
                                <label class="merchant-config-row">
                                    <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.source"}}</span>
                                    <select data-inventory-source="{{id}}">
                                        {{#each sourceOptions}}
                                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                        {{/each}}
                                    </select>
                                </label>
                                {{#unless queryAvailable}}
                                    <small class="merchant-config-hint merchant-config-rate-warning">
                                        {{localize "coffee-pub-merchant.config.queryUnavailable"}}
                                    </small>
                                {{/unless}}
                            </div>

                            {{#if isManual}}
                                <div class="merchant-config-inv-group">
                                    <div class="merchant-config-note">{{localize "coffee-pub-merchant.config.manualNote"}}</div>
                                </div>
                            {{/if}}
                            {{#if isTable}}
                            <div class="merchant-config-inv-group">
                                <h4>{{localize "coffee-pub-merchant.config.rollTables"}}</h4>
                                {{#if hasTables}}
                                    <div class="merchant-config-grid">
                                        {{#each tables}}
                                            {{!-- What the table will do is on the input
                                                  as a tooltip rather than as a line of
                                                  prose under every row: five tables
                                                  meant five sentences saying almost the
                                                  same thing. --}}
                                            <div class="merchant-config-row merchant-config-row-inline merchant-config-table{{#unless enabled}} is-off{{/unless}}">
                                                <span class="merchant-config-label merchant-config-table-name"
                                                      data-tooltip="{{name}}">
                                                    {{!-- Off keeps the table and its
                                                          settings and simply stops it
                                                          contributing — a seasonal
                                                          table should not have to be
                                                          removed and re-dropped. --}}
                                                    <input type="checkbox" class="merchant-config-table-enabled"
                                                           data-inventory-table-enabled="{{../id}}"
                                                           data-table-uuid="{{uuid}}" {{#if enabled}}checked{{/if}}
                                                           aria-label="{{localize "coffee-pub-merchant.config.useTable"}}">
                                                    <i class="fa-solid fa-dice-d20"></i> {{name}}
                                                </span>
                                                <div class="merchant-config-table-controls">
                                                    <label class="merchant-config-inline"
                                                           data-tooltip="{{drawTooltip}}">
                                                        <span>{{localize "coffee-pub-merchant.config.draw"}}</span>
                                                        <input type="number" min="1" max="20" step="1" value="{{rolls}}"
                                                               data-inventory-table-rolls="{{../id}}" data-table-uuid="{{uuid}}"
                                                               aria-label="{{localize "coffee-pub-merchant.config.drawLabel"}}">
                                                    </label>
                                                    <button type="button" class="merchant-config-icon-btn merchant-config-remove"
                                                            data-action="removeInventoryTable" data-inventory-id="{{../id}}"
                                                            data-table-uuid="{{uuid}}"
                                                            data-tooltip="{{localize "coffee-pub-merchant.config.removeTableTooltip"}}">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                <div class="merchant-config-drop">
                                    <i class="fa-solid fa-dice-d20"></i>
                                    {{#if hasTables}}Drop another roll table to add it{{else}}Drop a roll table here to stock this inventory by rolling{{/if}}
                                </div>
                            </div>
                            {{/if}}
                        {{/if}}
                            {{#if isQuery}}
                                <div class="merchant-config-inv-group">
                                    <h4>{{localize "coffee-pub-merchant.config.queryFilter"}}</h4>
                                    {{!-- Two ends of one range, the same control the
                                          trading hours use. Stops are roughly
                                          logarithmic — shop prices span four orders of
                                          magnitude, and a linear slider spends nine
                                          tenths of its travel in a band no shop cares
                                          about. The top stop reads **Any**. --}}
                                    <div class="merchant-config-row merchant-config-row-tall">
                                        <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.priceRange"}}</span>
                                        <div class="merchant-config-hours">
                                            <div class="merchant-config-hours-row">
                                                <span class="merchant-config-hours-bound">{{priceFloorLabel}}</span>
                                                <div class="merchant-config-hours-slider" data-price-slider="{{id}}">
                                                    <div class="merchant-config-hours-fill" data-price-fill></div>
                                                    <input type="range" min="0" max="{{priceMaxIndex}}" step="1" value="{{priceMinIndex}}"
                                                           data-price-min aria-label="{{localize "coffee-pub-merchant.config.priceFrom"}}">
                                                    <input type="range" min="0" max="{{priceMaxIndex}}" step="1" value="{{priceTopIndex}}"
                                                           data-price-max aria-label="{{localize "coffee-pub-merchant.config.priceTo"}}">
                                                </div>
                                                <span class="merchant-config-hours-bound">{{priceCeilingLabel}}</span>
                                                <output class="merchant-config-price-value" data-price-label>{{priceLabel}}</output>
                                            </div>
                                        </div>
                                    </div>

                                    {{!-- **Two questions, two labelled groups.** Kinds and
                                          rarities were adjacent rows of identical chips,
                                          which read as one long list of unrelated things
                                          and invited ticking a rarity to mean a kind. --}}
                                    <div class="merchant-config-chipset">
                                        <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.kinds"}}</span>
                                        <div class="merchant-config-chips" data-inventory-query-kinds="{{id}}">
                                            {{#each queryKinds}}
                                                <label class="merchant-config-chip{{#if on}} is-on{{/if}}">
                                                    <input type="checkbox" value="{{value}}" {{#if on}}checked{{/if}}>
                                                    <span>{{label}}</span>
                                                </label>
                                            {{/each}}
                                        </div>
                                    </div>
                                    <div class="merchant-config-chipset">
                                        <span class="merchant-config-label">{{localize "coffee-pub-merchant.config.rarities"}}</span>
                                        <div class="merchant-config-chips" data-inventory-query-rarity="{{id}}">
                                            {{#each queryRarities}}
                                                <label class="merchant-config-chip{{#if on}} is-on{{/if}}">
                                                    <input type="checkbox" value="{{value}}" {{#if on}}checked{{/if}}>
                                                    <span>{{label}}</span>
                                                </label>
                                            {{/each}}
                                        </div>
                                    </div>

                                    <div class="merchant-config-note">{{localize "coffee-pub-merchant.config.queryNote"}}</div>
                                </div>
                            {{/if}}
                    </div>
                {{/each}}
            {{else}}
                <div class="merchant-config-empty">{{localize "coffee-pub-merchant.config.noInventories"}}</div>
            {{/if}}
        </section>
    {{/if}}
</div>
