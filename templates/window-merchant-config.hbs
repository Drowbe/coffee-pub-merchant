{{!--
    Merchant Settings.

    **Every setting is a labelled pair, never a sentence.** There used to be controls
    embedded in prose — "every [4] days", "[25] products [3] each" — which asks the
    reader to parse a sentence to find out what a box does, and leaves nothing to
    align. A label in one column and its control in the next can be scanned down.

    Saving is live. The Saved pip in the title row is the feedback for that; the
    footer's primary button closes rather than commits, because there is nothing
    outstanding to commit.
--}}
<div class="merchant-config-content">

    {{!-- The subject card carries the toggle, because whether this Actor is a shop at
          all is the biggest fact on the screen and belongs with its name. --}}
    <section class="merchant-config-section merchant-config-subject">
        <div class="merchant-config-image"><img src="{{portraitImg}}" alt="{{actorName}}"></div>
        <div class="merchant-config-copy">
            <div class="merchant-config-kicker">Merchant Settings</div>
            <div class="merchant-config-title">{{actorName}}</div>
        </div>
        <label class="merchant-config-enable{{#if enabled}} is-on{{/if}}"
               data-tooltip="Players can double-click this token to open its shop.">
            <input type="checkbox" data-merchant-enabled {{#if enabled}}checked{{/if}}>
            <span>Is a merchant</span>
        </label>
    </section>

    {{#if enabled}}
        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-store"></i> The Shop</span>
            </h3>

            <div class="merchant-config-grid">
                <label class="merchant-config-row">
                    <span class="merchant-config-label">Shop name</span>
                    <input type="text" value="{{shopName}}" placeholder="{{actorName}}" data-merchant-name>
                    <small class="merchant-config-hint">Blank names the shop after whoever runs it.</small>
                </label>

                <label class="merchant-config-row">
                    <span class="merchant-config-label">Kind</span>
                    <select data-merchant-kind>
                        {{#each kindOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                    <small class="merchant-config-hint">Flavour only. Shown above the name in the shop.</small>
                </label>

                <label class="merchant-config-row merchant-config-row-tall">
                    <span class="merchant-config-label">Description</span>
                    <textarea data-merchant-description rows="3"
                              placeholder="A cramped shop that smells of oil and iron filings.">{{description}}</textarea>
                    <small class="merchant-config-hint">Shown to players. Links and inline rolls work.</small>
                </label>
            </div>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-clock"></i> Trading Hours</span>
                <span class="merchant-config-hours-always{{#if alwaysClosed}} is-closed{{/if}}"
                      data-hours-badge {{#unless hoursBadge}}hidden{{/unless}}>{{hoursBadge}}</span>
            </h3>

            <div class="merchant-config-grid">
                <div class="merchant-config-row">
                    <span class="merchant-config-label">Open</span>
                    <div class="merchant-config-hours">
                        <div class="merchant-config-hours-row">
                            <span class="merchant-config-hours-bound">{{dayStartLabel}}</span>
                            <div class="merchant-config-hours-slider" data-hours-slider>
                                <div class="merchant-config-hours-fill" data-hours-fill></div>
                                <input type="range" min="0" max="{{maxHour}}" step="1" value="{{openHour}}" data-hours-open aria-label="Opening hour">
                                <input type="range" min="0" max="{{dayEnd}}" step="1" value="{{closeHour}}" data-hours-close aria-label="Closing hour">
                            </div>
                            <span class="merchant-config-hours-bound">{{dayEndLabel}}</span>
                        </div>
                    </div>
                    <small class="merchant-config-hint">
                        <strong data-hours-open-label>{{openLabel}}</strong> to
                        <strong data-hours-close-label>{{closeLabel}}</strong>
                    </small>
                </div>
            </div>

            {{#if overridden}}
                <div class="merchant-config-note">
                    Currently overriding the schedule. The next opening or closing hour will set it straight.
                </div>
            {{/if}}
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-sack-dollar"></i> The Till</span>
                {{!-- What the coins below come to in total. It reads as a different
                      number from the boxes because it *is* one: everything converted
                      to the coins a price is quoted in, so 400 platinum shows up as
                      gold. Unlabelled it looked like a contradiction. --}}
                <span class="merchant-config-count merchant-config-till-total"
                      data-tooltip="Everything in the till, converted to the coins prices are quoted in">
                    Worth {{tillLabel}}
                </span>
            </h3>

            {{!-- Every denomination the system defines, pre-filled with what the shop
                  actually holds. It used to be a single gold box, which quietly said
                  the other four coins did not exist and could not show a shop its own
                  silver. --}}
            <div class="merchant-config-till">
                {{#each till}}
                    <label class="merchant-config-coin">
                        <span class="merchant-config-coin-label">{{label}}</span>
                        <input type="number" min="0" step="1" value="{{value}}"
                               data-merchant-coin="{{key}}" aria-label="{{label}} in the till">
                    </label>
                {{/each}}
            </div>
            <small class="merchant-config-hint">What this shop can pay out when the party sells to it.</small>
            {{#if tillEmpty}}
                <div class="merchant-config-note is-warning">
                    An empty till cannot buy anything &mdash; the party will be refused when they try to sell.
                </div>
            {{/if}}
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-tags"></i> Pricing</span></h3>

            <div class="merchant-config-grid">
                {{> "modules/coffee-pub-merchant/templates/partial-rate.hbs" globalMarkup}}
            </div>
            <small class="merchant-config-hint">
                The baseline for everything in this shop. Each inventory multiplies against it.
            </small>

            <label class="merchant-config-enable merchant-config-enable-inline{{#if reputationOn}} is-on{{/if}}">
                <input type="checkbox" data-merchant-reputation {{#if reputationOn}}checked{{/if}}>
                <span>Reputation impacts prices</span>
            </label>
            {{!-- One sentence, and only the range. **Where this party actually stands
                  belongs in the shop**, under who you are shopping as — it is a fact
                  about a visit, not a setting, and it was taking three lines in the
                  window where a GM is configuring rather than trading. --}}
            <small class="merchant-config-hint">
                Reputation can adjust prices from a {{reputationPenalty}} penalty to a
                {{reputationBenefit}} benefit.
            </small>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-layer-group"></i> Inventories</span>
                <span class="merchant-config-head-actions">
                    <button type="button" class="merchant-config-inventory-add" data-action="addInventory"
                            data-tooltip="Add an inventory">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <span class="merchant-config-count">{{inventoryCount}}</span>
                </span>
            </h3>

            {{#if hasInventories}}
                {{#each inventories}}
                    {{!-- Each inventory is its own card with its own headings, so it
                          reads like the shop window rather than like a row in a table
                          that grew settings. --}}
                    <div class="merchant-config-inv"{{#if canRoll}} data-drop-table="{{id}}"{{/if}}>

                        {{!-- **The category is the heading; the name is content.** The
                              type is what this card *is* and cannot be changed, which
                              is what a heading says; the name is a thing the GM writes,
                              so it belongs in the card with the artwork it goes with. --}}
                        <h3 class="merchant-config-inv-head">
                            <span>
                                {{typeLabel}}
                                {{#if hidden}}
                                    <span class="merchant-config-inv-hidden"
                                          data-tooltip="Players are never sent this inventory">
                                        <i class="fa-solid fa-eye-slash"></i> Hidden
                                    </span>
                                {{/if}}
                            </span>
                            <span class="merchant-config-head-actions">
                                {{#if canRoll}}
                                    <button type="button" class="merchant-config-inv-btn"
                                            data-action="restockInventory" data-inventory-id="{{id}}"
                                            data-tooltip="Refill this inventory now">
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                    </button>
                                {{/if}}
                                <button type="button" class="merchant-config-inv-btn"
                                        data-action="openInventory" data-inventory-id="{{id}}"
                                        data-tooltip="Open this inventory to stock it">
                                    <i class="fa-solid fa-box-open"></i>
                                </button>
                                <button type="button" class="merchant-config-inv-btn"
                                        data-action="clearInventory" data-inventory-id="{{id}}"
                                        data-tooltip="Take everything off this inventory">
                                    <i class="fa-solid fa-broom"></i>
                                </button>
                                <button type="button" class="merchant-config-inv-btn merchant-config-remove"
                                        data-action="removeInventory" data-inventory-id="{{id}}"
                                        data-tooltip="Remove this inventory">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <span class="merchant-config-count"
                                      data-tooltip="{{count}} item{{#unless one}}s{{/unless}} on this inventory">{{count}}</span>
                            </span>
                        </h3>

                        <div class="merchant-config-inv-identity">
                            <button type="button" class="merchant-config-inventory-art"
                                    data-inventory-image="{{id}}"
                                    data-tooltip="Click to choose different artwork">
                                <img src="{{img}}" alt="">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <input type="text" class="merchant-config-inventory-name" value="{{label}}"
                                   data-inventory-name="{{id}}" aria-label="Inventory name"
                                   placeholder="{{typeLabel}}">
                        </div>

                        {{#if hasRates}}
                            <div class="merchant-config-inv-group">
                                <h4>Pricing</h4>
                                <div class="merchant-config-grid">
                                    {{#each rates}}
                                        {{> "modules/coffee-pub-merchant/templates/partial-rate.hbs" this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{/if}}
                        {{#if pricingNone}}
                            <div class="merchant-config-inv-group">
                                <h4>Pricing</h4>
                                <div class="merchant-config-note">
                                    No price until one is agreed with the party on the slate.
                                </div>
                            </div>
                        {{/if}}

                        <div class="merchant-config-inv-group">
                            <h4>Restock</h4>
                            {{#if canRoll}}
                                {{!-- One row: what happens, how often, and how deep it
                                      stacks are one decision made in one glance. They
                                      wrap when the window is narrow rather than
                                      squeezing, and Frequency is simply absent on a
                                      method that has no cadence. --}}
                                <div class="merchant-config-restock">
                                    <label class="merchant-config-row merchant-config-restock-method">
                                        <span class="merchant-config-label">Method</span>
                                        <select data-inventory-stock="{{id}}">
                                            {{#each stockOptions}}
                                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                            {{/each}}
                                        </select>
                                    </label>

                                    {{#if restocking}}
                                        <label class="merchant-config-row">
                                            <span class="merchant-config-label">Frequency</span>
                                            <select data-inventory-frequency="{{id}}">
                                                {{#each frequencyOptions}}
                                                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                                {{/each}}
                                            </select>
                                        </label>
                                    {{/if}}

                                    {{#if showMaxStack}}
                                        <label class="merchant-config-row merchant-config-restock-stack"
                                               data-tooltip="{{maxStackTooltip}}">
                                            <span class="merchant-config-label">Max stack</span>
                                            <input type="number" min="1" max="999" step="1" value="{{maxPerItem}}"
                                                   data-inventory-max-per-item="{{id}}"
                                                   aria-label="Maximum quantity of any one item">
                                        </label>
                                    {{/if}}
                                </div>
                            {{else}}
                                <div class="merchant-config-note">
                                    Items bought from this inventory are removed and never restocked. Its stock is
                                    whatever the party has sold to the shop.
                                </div>
                            {{/if}}
                        </div>

                        {{#if canRoll}}
                            <div class="merchant-config-inv-group">
                                <h4>Roll Tables</h4>
                                {{#if hasTables}}
                                    <div class="merchant-config-grid">
                                        {{#each tables}}
                                            {{!-- What the table will do is on the input
                                                  as a tooltip rather than as a line of
                                                  prose under every row: five tables
                                                  meant five sentences saying almost the
                                                  same thing. --}}
                                            <div class="merchant-config-row merchant-config-row-inline merchant-config-table{{#unless enabled}} is-off{{/unless}}">
                                                <span class="merchant-config-label merchant-config-table-name"
                                                      data-tooltip="{{name}}">
                                                    {{!-- Off keeps the table and its
                                                          settings and simply stops it
                                                          contributing — a seasonal
                                                          table should not have to be
                                                          removed and re-dropped. --}}
                                                    <input type="checkbox" class="merchant-config-table-enabled"
                                                           data-inventory-table-enabled="{{../id}}"
                                                           data-table-uuid="{{uuid}}" {{#if enabled}}checked{{/if}}
                                                           aria-label="Use this table">
                                                    <i class="fa-solid fa-dice-d20"></i> {{name}}
                                                </span>
                                                <div class="merchant-config-table-controls">
                                                    <label class="merchant-config-inline"
                                                           data-tooltip="{{drawTooltip}}">
                                                        <span>Draw</span>
                                                        <input type="number" min="1" max="20" step="1" value="{{rolls}}"
                                                               data-inventory-table-rolls="{{../id}}" data-table-uuid="{{uuid}}"
                                                               aria-label="How many items to draw from this table">
                                                    </label>
                                                    <button type="button" class="merchant-config-icon-btn merchant-config-remove"
                                                            data-action="removeInventoryTable" data-inventory-id="{{../id}}"
                                                            data-table-uuid="{{uuid}}"
                                                            data-tooltip="Take this table off the inventory">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                <div class="merchant-config-drop">
                                    <i class="fa-solid fa-dice-d20"></i>
                                    {{#if hasTables}}Drop another roll table to add it{{else}}Drop a roll table here to stock this inventory by rolling{{/if}}
                                </div>
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            {{else}}
                <div class="merchant-config-empty">No inventories yet. Add one to start stocking this merchant.</div>
            {{/if}}
        </section>
    {{/if}}
</div>
