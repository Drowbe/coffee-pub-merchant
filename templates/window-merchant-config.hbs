<div class="merchant-config-content">
    <section class="merchant-config-section merchant-config-subject">
        <div class="merchant-config-image"><img src="{{portraitImg}}" alt="{{actorName}}"></div>
        <div class="merchant-config-copy">
            <div class="merchant-config-kicker">Merchant Settings</div>
            <div class="merchant-config-title">{{actorName}}</div>
        </div>
    </section>

    <section class="merchant-config-section">
        <label class="merchant-config-toggle">
            <input type="checkbox" data-merchant-enabled {{#if enabled}}checked{{/if}}>
            <span>
                <strong>Is a merchant</strong>
                <small>Players can double-click this token to open its shop.</small>
            </span>
        </label>
    </section>

    {{#if enabled}}
        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-clock"></i> Trading Hours</span>
                {{#if hasHours}}
                    <button type="button" class="blacksmith-window-btn-secondary merchant-config-hours-clear"
                            data-action="clearHours" data-tooltip="Remove the schedule; the shop then only opens and closes by hand">
                        Always open
                    </button>
                {{/if}}
            </h3>

            <div class="merchant-config-hours">
                <div class="merchant-config-hours-readout">
                    {{#if hasHours}}
                        <span>Opens <strong data-hours-open-label>{{openLabel}}</strong></span>
                        <span>Closes <strong data-hours-close-label>{{closeLabel}}</strong></span>
                    {{else}}
                        <span>No schedule &mdash; open and closed by hand.</span>
                    {{/if}}
                </div>

                {{!-- Two ranges stacked into one track, so a single control carries
                      both ends. --}}
                <div class="merchant-config-hours-slider" data-hours-slider>
                    <div class="merchant-config-hours-fill" data-hours-fill></div>
                    <input type="range" min="0" max="{{maxHour}}" step="1" value="{{openHour}}" data-hours-open aria-label="Opening hour">
                    <input type="range" min="0" max="{{maxHour}}" step="1" value="{{closeHour}}" data-hours-close aria-label="Closing hour">
                </div>

                {{#if overridden}}
                    <div class="merchant-config-hours-note">
                        Currently overriding the schedule. The next opening or closing hour will set it straight.
                    </div>
                {{/if}}
            </div>
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-store"></i> The Shop</span></h3>
            <label class="merchant-config-markup merchant-config-field">
                <span>
                    <strong>Shop name</strong>
                    <small>What the sign says. Leave it blank and the shop is called after whoever
                           runs it.</small>
                </span>
                <input type="text" value="{{shopName}}" placeholder="{{actorName}}" data-merchant-name>
            </label>

            <label class="merchant-config-markup merchant-config-field">
                <span>
                    <strong>Kind of shop</strong>
                    <small>Flavour only &mdash; nothing is restricted by it. Shown above the name.</small>
                </span>
                <select data-merchant-kind>
                    {{#each kindOptions}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                </select>
            </label>

            <div class="merchant-config-description">
                <span>
                    <strong>Description</strong>
                    <small>Optional. Shown to players under the shop name. Links and rolls work.</small>
                </span>
                <textarea data-merchant-description rows="3"
                          placeholder="A cramped shop that smells of oil and iron filings.">{{description}}</textarea>
            </div>
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-boxes-stacked"></i> Stock</span></h3>
            <label class="merchant-config-markup merchant-config-field">
                <span>
                    <strong>When something is bought</strong>
                    <small>The shop's default. Any shelf may say otherwise &mdash; Buyback always runs out.</small>
                </span>
                <select data-merchant-stock>
                    {{#each merchantStockOptions}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                </select>
            </label>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-sack-dollar"></i> The Till</span>
                <span class="merchant-config-count merchant-config-till-total">{{tillLabel}}</span>
            </h3>
            <label class="merchant-config-markup">
                <span>
                    <strong>Gold to spend</strong>
                    <small>What this shop can pay out when the party sells to it. Other coin it holds is
                           left alone.</small>
                </span>
                <input type="number" min="0" step="1" value="{{tillGold}}" data-merchant-till>
            </label>
            {{#if tillEmpty}}
                <div class="merchant-config-hours-note">
                    An empty till cannot buy anything &mdash; the party will be refused when they try to sell.
                </div>
            {{/if}}
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-tags"></i> Pricing</span></h3>
            <label class="merchant-config-markup">
                <span>
                    <strong>Markup</strong>
                    <small>Applied to each item's own price. A shelf may override this; Premium ships at 1.5.</small>
                </span>
                <input type="number" min="0" step="0.05" value="{{markup}}" data-merchant-markup>
            </label>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-layer-group"></i> Shelves</span>
                <span class="merchant-config-head-actions">
                    <button type="button" class="merchant-config-shelf-add" data-action="addShelf"
                            data-tooltip="Add a shelf">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <span class="merchant-config-count">{{shelfCount}}</span>
                </span>
            </h3>

            {{#if hasShelves}}
                <div class="merchant-config-shelf-list">
                    {{#each shelves}}
                        <div class="merchant-config-shelf" data-drop-table="{{id}}">
                            <img src="{{img}}" alt="">
                            <div class="merchant-config-shelf-copy">
                                <strong>{{label}}</strong>
                                <span>{{count}} item{{#unless one}}s{{/unless}}{{#if hidden}} · hidden from players{{/if}}</span>
                            </div>
                            <div class="merchant-config-shelf-actions">
                                {{#if countable}}
                                    <button type="button" class="blacksmith-window-btn-secondary merchant-config-icon-btn"
                                            data-action="restockShelf" data-shelf-id="{{id}}"
                                            data-tooltip="Refill this shelf to the quantities you set">
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                    </button>
                                {{/if}}
                                <button type="button" class="blacksmith-window-btn-secondary merchant-config-icon-btn"
                                        data-action="openShelf" data-shelf-id="{{id}}" data-tooltip="Open this shelf to stock it">
                                    <i class="fa-solid fa-box-open"></i>
                                </button>
                                <button type="button" class="blacksmith-window-btn-secondary merchant-config-icon-btn merchant-config-remove"
                                        data-action="removeShelf" data-shelf-id="{{id}}" data-tooltip="Remove this shelf">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>

                            {{!-- A second row under the shelf's identity rather than
                                  beside it, so the name stays on one line. --}}
                            <div class="merchant-config-shelf-stock">
                                <select data-shelf-stock="{{id}}"
                                        data-tooltip="What happens to this shelf when something is bought">
                                    {{#each stockOptions}}
                                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#if inherited}}
                                    <span class="merchant-config-shelf-inherited">{{stockLabel}}</span>
                                {{/if}}
                                {{#if restocking}}
                                    <label class="merchant-config-shelf-days" data-tooltip="In-world days between refills">
                                        every
                                        <input type="number" min="1" step="1" value="{{restockDays}}"
                                               data-shelf-restock-days="{{id}}" aria-label="Days between restocks">
                                        day{{#unless oneDay}}s{{/unless}}
                                    </label>
                                {{/if}}
                            </div>

                            {{!-- A shelf may also be stocked by rolling. Dragged on
                                  rather than picked from a list, the same way stock
                                  itself is put on a shelf. --}}
                            <div class="merchant-config-shelf-tables">
                                {{#each tables}}
                                    <div class="merchant-config-shelf-table">
                                        <span class="merchant-config-shelf-table-name" data-tooltip="{{name}} — rolled when this shelf restocks">
                                            <i class="fa-solid fa-dice-d20"></i> {{name}}
                                        </span>
                                        <label class="merchant-config-shelf-rolls" data-tooltip="How many times to roll it">
                                            <input type="number" min="1" max="20" step="1" value="{{rolls}}"
                                                   data-shelf-table-rolls="{{../id}}" data-table-uuid="{{uuid}}"
                                                   aria-label="Rolls per restock">
                                            roll{{#unless oneRoll}}s{{/unless}}
                                        </label>
                                        <button type="button" class="merchant-config-icon-btn merchant-config-remove"
                                                data-action="removeShelfTable" data-shelf-id="{{../id}}"
                                                data-table-uuid="{{uuid}}"
                                                data-tooltip="Take this table off the shelf">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </div>
                                {{/each}}
                                <span class="merchant-config-shelf-table-empty">
                                    <i class="fa-solid fa-dice-d20"></i>
                                    {{#if hasTables}}Drop another roll table to add it{{else}}Drop a roll table here to stock it by rolling{{/if}}
                                </span>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="merchant-config-empty">No shelves yet. Add one to start stocking this merchant.</div>
            {{/if}}

        </section>
    {{/if}}

    {{!-- Markup and per-item price overrides land here in phase 2. --}}
</div>
