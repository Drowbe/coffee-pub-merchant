<div class="merchant-config-content">
    <section class="merchant-config-section merchant-config-subject">
        <div class="merchant-config-image"><img src="{{portraitImg}}" alt="{{actorName}}"></div>
        <div class="merchant-config-copy">
            <div class="merchant-config-kicker">Merchant Settings</div>
            <div class="merchant-config-title">{{actorName}}</div>
        </div>
    </section>

    <section class="merchant-config-section">
        <label class="merchant-config-toggle">
            <input type="checkbox" data-merchant-enabled {{#if enabled}}checked{{/if}}>
            <span>
                <strong>Is a merchant</strong>
                <small>Players can double-click this token to open its shop.</small>
            </span>
        </label>
    </section>

    {{#if enabled}}
        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-clock"></i> Trading Hours</span>
                {{#if hasHours}}
                    <button type="button" class="blacksmith-window-btn-secondary merchant-config-hours-clear"
                            data-action="clearHours" data-tooltip="Remove the schedule; the shop then only opens and closes by hand">
                        Always open
                    </button>
                {{/if}}
            </h3>

            <div class="merchant-config-hours">
                <div class="merchant-config-hours-readout">
                    {{#if hasHours}}
                        <span>Opens <strong data-hours-open-label>{{openLabel}}</strong></span>
                        <span>Closes <strong data-hours-close-label>{{closeLabel}}</strong></span>
                    {{else}}
                        <span>No schedule &mdash; open and closed by hand.</span>
                    {{/if}}
                </div>

                {{!-- Two ranges stacked into one track, so a single control carries
                      both ends. --}}
                <div class="merchant-config-hours-slider" data-hours-slider>
                    <div class="merchant-config-hours-fill" data-hours-fill></div>
                    <input type="range" min="0" max="{{maxHour}}" step="1" value="{{openHour}}" data-hours-open aria-label="Opening hour">
                    <input type="range" min="0" max="{{maxHour}}" step="1" value="{{closeHour}}" data-hours-close aria-label="Closing hour">
                </div>

                {{#if overridden}}
                    <div class="merchant-config-hours-note">
                        Currently overriding the schedule. The next opening or closing hour will set it straight.
                    </div>
                {{/if}}
            </div>
        </section>

        <section class="merchant-config-section">
            <h3><span><i class="fa-solid fa-tags"></i> Pricing</span></h3>
            <label class="merchant-config-markup">
                <span>
                    <strong>Markup</strong>
                    <small>Applied to each item's own price. A shelf may override this; Premium ships at 1.5.</small>
                </span>
                <input type="number" min="0" step="0.05" value="{{markup}}" data-merchant-markup>
            </label>
        </section>

        <section class="merchant-config-section">
            <h3>
                <span><i class="fa-solid fa-layer-group"></i> Shelves</span>
                <span class="merchant-config-count">{{shelfCount}}</span>
            </h3>

            {{#if hasShelves}}
                <div class="merchant-config-shelf-list">
                    {{#each shelves}}
                        <div class="merchant-config-shelf">
                            <img src="{{img}}" alt="">
                            <div class="merchant-config-shelf-copy">
                                <strong>{{label}}</strong>
                                <span>{{count}} item{{#unless one}}s{{/unless}}{{#if hidden}} · hidden from players{{/if}}</span>
                            </div>
                            <div class="merchant-config-shelf-actions">
                                <button type="button" class="blacksmith-window-btn-secondary merchant-config-icon-btn"
                                        data-action="openShelf" data-shelf-id="{{id}}" data-tooltip="Open this shelf to stock it">
                                    <i class="fa-solid fa-box-open"></i>
                                </button>
                                <button type="button" class="blacksmith-window-btn-secondary merchant-config-icon-btn merchant-config-remove"
                                        data-action="removeShelf" data-shelf-id="{{id}}" data-tooltip="Remove this shelf">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="merchant-config-empty">No shelves yet. Add one to start stocking this merchant.</div>
            {{/if}}

            {{!-- Created here rather than dragged from a compendium: a pack is a thing
                  to maintain and its items can be edited into something malformed. --}}
            <div class="merchant-config-add">
                {{#each presets}}
                    <button type="button" class="blacksmith-window-btn-secondary merchant-config-add-btn"
                            data-action="addShelf" data-preset="{{key}}" data-tooltip="{{hint}}">
                        <img src="{{img}}" alt=""> {{name}}
                    </button>
                {{/each}}
            </div>
        </section>
    {{/if}}

    {{!-- Markup and per-item price overrides land here in phase 2. --}}
</div>
