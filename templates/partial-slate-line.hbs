{{!--
    One line on the slate. Used twice — buying and selling — which differ only in
    which map the quantity is written to and which action removes it, so both ride
    on the line itself rather than being two copies of this markup.

    A single row, unlike an inventory row: icon, name, quantity, price. The name takes
    whatever width is left and ellipsises, because a slate is a narrow column and
    "Cordial of Holiday Insight" will not fit in it whatever else is done.
--}}
<div class="merchant-shop-cart-line" data-item-id="{{id}}">
    <img src="{{img}}" alt="">
    <span class="merchant-shop-cart-name">{{name}}</span>
    <span class="merchant-shop-cart-qty merchant-shop-qty-editable"
          data-edit-line="{{id}}" data-line-side="{{side}}"
          data-tooltip="{{localize "coffee-pub-merchant.slate.quantityTooltip"}}">&times;<strong>{{quantity}}</strong></span>
    {{!-- The GM can name a price on any line, which is the whole of haggling: a
          discount on a listed thing and a first price on an unlisted one are the
          same gesture. Players see the number, not the handle. --}}
    {{#if canPrice}}
        <span class="merchant-shop-cart-total merchant-shop-qty-editable{{#unless agreed}} is-tbd{{/unless}}"
              data-edit-price="{{id}}" data-line-side="{{side}}" data-price-each="{{priceEach}}"
              data-tooltip="{{priceTooltip}}"><strong>{{totalLabel}}</strong></span>
    {{else}}
        <span class="merchant-shop-cart-total{{#unless agreed}} is-tbd{{/unless}}"
              {{#unless agreed}}data-tooltip="{{localize "coffee-pub-merchant.slate.tbdTooltip"}}"{{/unless}}>{{totalLabel}}</span>
    {{/if}}
    {{!-- Last, at the far edge: removing is the one destructive thing on the line,
          so it sits apart from the numbers rather than beside one of them. --}}
    <button type="button" class="merchant-shop-cart-remove" data-action="{{removeAction}}"
            data-item-id="{{id}}" data-tooltip="{{localize "coffee-pub-merchant.slate.removeTooltip"}}">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>
